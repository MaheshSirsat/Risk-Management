{
  "name": "risk-management",
  "version": "1.0.0",
  "dependencies": {
    "@cap-js/hana": "^2",
    "@sap/cds": "^9",
    "@sap/cds-mtxs": "^3",
    "@sap/xssec": "^4",
    "@sap-cloud-sdk/connectivity": "^4",
    "@sap-cloud-sdk/http-client": "^4",
    "@sap-cloud-sdk/resilience": "^4"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2.4",
    "@sap/cds-dk": "^9",
    "cds-plugin-ui5": "^0.13.0",
    "rimraf": "^5.0.5",
    "mbt": "^1.2.29"
  },
  "scripts": {
    "start": "cds-serve",
    "watch-risks": "cds watch --open risks/index.html?sap-ui-xx-viewCache=false --livereload false",
    "undeploy": "cf undeploy risk-management --delete-services --delete-service-keys --delete-service-brokers",
    "build": "rimraf resources mta_archives && mbt build --mtar archive",
    "deploy": "cf deploy mta_archives/archive.mtar --retries 1",
    "watch-mitigation": "cds watch --open mitigation/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "private": true,
  "cds": {
    "requires": {
      "[production]": {
        "auth": "xsuaa",
        "multitenancy": true
      },
      "db": {
        "kind": "sql"
      },
      "[with-mtx]": {
        "multitenancy": true
      },
      "auth": {
        "kind": "mocked",
        "users": {
          "mahesh.sirsat@vaspp.com": {
           
            "roles": [
              "RiskManager"
            ]
          },
          "mahesh@vaspp.com": {
            "password": "Initial@1",
            "roles": []
          }
        }
      },
      "connectivity": true,
      "destinations": true,
      "html5-repo": true,
      "API_BUSINESS_PARTNER": {
        "kind": "odata-v2",
        "model": "srv/external/API_BUSINESS_PARTNER",
        "[production]": {
          "credentials": {
            "path": "/s4hanacloud/sap/opu/odata/sap/API_BUSINESS_PARTNER",
            "destination": "apihub_sandbox"
          }
        }
      }
    },
    "profile": "with-mtx-sidecar"
  },
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/risks",
    "app/mitigation"
  ]
}
